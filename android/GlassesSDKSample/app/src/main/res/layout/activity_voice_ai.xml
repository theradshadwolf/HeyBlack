<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <!-- Title bar row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btn_back_voice_ai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_ai_back"
            android:textSize="14sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/voice_ai_title"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Status indicator -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/voice_ai_ready"
        android:textSize="16sp"
        android:gravity="center"
        android:paddingBottom="12dp"
        android:textColor="#555555" />

    <!-- Conversation log -->
    <ScrollView
        android:id="@+id/scroll_conversation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F5F5F5"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_conversation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:hint="@string/voice_ai_conversation_hint" />

    </ScrollView>

    <!-- Listen button -->
    <Button
        android:id="@+id/btn_listen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/voice_ai_tap_to_speak"
        android:textSize="18sp"
        android:padding="16dp" />

</LinearLayout>
